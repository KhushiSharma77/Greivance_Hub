# Database
DATABASE_URL="postgresql://user:password@localhost:5432/grievancehub"

# Authentication
JWT_SECRET="your_secret_key_here"

# Frontend (Vercel)
# In production, this should be the URL of your Render backend
NEXT_PUBLIC_SERVER_URL="https://your-backend.render.com"

# Backend (Render)
# In production, this should be the URL of your Vercel frontend
CORS_ORIGIN="https://your-frontend.vercel.app"

# Supabase (Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Redis (Queues - Render/Upstash)
REDIS_URL="redis://localhost:6379"

# Email (SMTP)
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# AI Engine
GEMINI_API_KEY="your-gemini-api-key"

# Environment
NODE_ENV="production"
