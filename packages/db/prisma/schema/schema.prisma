generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  citizen
  officer
  admin
}

enum GrievanceStatus {
  PENDING
  ANALYZED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PriorityLevel {
  Low
  Medium
  High
}

enum SentimentType {
  Positive
  Neutral
  Negative
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


model User {
  id            String      @id @default(uuid())
  name          String
  email         String?     @unique
  phone         String?
  password      String
  role          UserRole
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  profilePicture String?
  address        String?
  aadhaarNumber  String?

  grievances    Grievance[] @relation("CitizenGrievances")
  assignedJobs  Grievance[] @relation("OfficerAssignments")
  upvotes       Upvote[]
  comments      Comment[]

  isVerified    Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model Department {
  id          String       @id @default(uuid())
  name        String
  City        String

  users       User[]
  grievances  Grievance[]

  createdAt  DateTime     @default(now())
}

model Grievance {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation("CitizenGrievances", fields: [userId], references: [id])

  originalText      String
  translatedText    String?

  category          String?
  priority          PriorityLevel?
  status            GrievanceStatus  @default(PENDING)
  imageUrl          String?

  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])

  assignedOfficerId String?
  assignedOfficer   User?            @relation("OfficerAssignments", fields: [assignedOfficerId], references: [id])

  duplicateOfId     String?
  duplicateOf       Grievance?        @relation("DuplicateRelation", fields: [duplicateOfId], references: [id])
  duplicates        Grievance[]       @relation("DuplicateRelation")

  latitude          Float?
  longitude         Float?

  isPublic          Boolean           @default(true)
  upvotes           Upvote[]
  comments          Comment[]

  aiMetadata        GrievanceAIMetadata?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Upvote {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, grievanceId]) // A user can only upvote a grievance once
}

model Comment {
  id          String    @id @default(uuid())
  content     String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


model GrievanceAIMetadata {
  grievanceId   String       @id
  grievance     Grievance    @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  urgency       Int?
  severity      Int?
  sentiment     SentimentType?
  confidence    Float?

  similarityScore Float?
  isDuplicate     Boolean    @default(false)

  analyzedAt    DateTime     @default(now())
}

